# ============================================================
#  ONT Restart Bot — template .env
#  Cara pakai: copy file ini jadi .env, lalu isi semua kolom.
#  JANGAN pernah commit .env ke git (sudah di .gitignore).
# ============================================================

# ---------- TELEGRAM ----------
# Token bot dari @BotFather (wajib).
TELEGRAM_BOT_TOKEN=

# User ID Telegram yang BOLEH pakai bot (pisah dengan spasi).
# Cara cek: kirim /myid ke bot setelah bot jalan.
# Kalau dikosongkan, SEMUA orang bisa pakai bot ini — gak disaranin.
TELEGRAM_ALLOWED_USERS=

# ---------- ACSIS ----------
# Kredensial login ACSIS ibooster (wajib).
ACSIS_USERNAME=
ACSIS_PASSWORD=

# Opsi di dropdown role di halaman login (default: Telkom Akses).
ACSIS_LOGIN_OPTION=Telkom Akses

# Secret TOTP dari Google Authenticator (wajib, tanpa spasi/"=").
# Cara dapetin ulang: Google Authenticator -> Export accounts -> scan QR,
# decode string otpauth-migration -> ambil bagian Secret.
ACSIS_TOTP_SECRET=

# Base URL ACSIS. Domain ini cuma resolve di jaringan Telkom —
# bot WAJIB jalan dari jaringan Telkom (PC rumah / VPS dalam negeri Telkom).
ACSIS_BASE_URL=https://acs-ibooster.telkom.co.id

# true = browser headless (tanpa window). false = tampilkan browser (debug).
ACSIS_HEADLESS=true

# ---------- DEBUG / LOG ----------
# INFO = log normal. DEBUG = sangat detail (gak disaranin, spam).
LOG_LEVEL=INFO

# Folder buat simpen screenshot tiap step (opsional). Kosongkan = mati.
# Contoh: DEBUG_SCREENSHOT_DIR=./screenshots
DEBUG_SCREENSHOT_DIR=
